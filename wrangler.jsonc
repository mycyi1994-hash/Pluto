{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pluto-robinhood", "main": "worker/index.js", "compatibility_date": "2026-10-11",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "observability": { "enabled": true },
  "vars": { "APP_ORIGIN": "https://pluto-robinhood.gana003.workers.dev" }
}
